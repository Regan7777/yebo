---
// 右下角全局一键置顶组件
---

<button id="global-back-to-top" class="global-back-to-top" title="一键置顶" aria-label="一键置顶">
  <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<script>
  const backToTopBtn = document.getElementById('global-back-to-top');

  if (backToTopBtn) {
    // 监听滚动显示/隐藏
    const toggleBackToTop = () => {
      if (window.scrollY > 300) {
        backToTopBtn.classList.add('is-visible');
      } else {
        backToTopBtn.classList.remove('is-visible');
      }
    };

    window.addEventListener('scroll', toggleBackToTop, { passive: true });
    toggleBackToTop();

    // 点击平滑置顶
    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }
</script>

<style>
  .global-back-to-top {
    position: fixed;
    right: 2rem;
    bottom: 2rem;
    z-index: 999;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(8, 20, 38, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0; /* 直角排版，拒绝 AI 圆角 */
    color: #94a3b8;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(16px);
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.5);
  }

  .global-back-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .global-back-to-top:hover {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.4);
    background: rgba(14, 32, 58, 0.95);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -4px rgba(56, 189, 248, 0.2);
  }

  .global-back-to-top:active {
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .global-back-to-top {
      right: 1.25rem;
      bottom: 1.5rem;
      width: 40px;
      height: 40px;
    }
  }
</style>

