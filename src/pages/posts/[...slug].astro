---
import { getCollection, render } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings ? headings.filter((h) => h.depth === 2 || h.depth === 3) : [];

const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(post.data.pubDate).replace(/\//g, '-');

const canonicalUrl = `https://yebo.baby/posts/${post.id}`;
const keywordsContent = post.data.keywords && post.data.keywords.length > 0
  ? post.data.keywords.join(', ')
  : `${post.data.title}, ${post.data.category}, 夜泊, 网络配置, 节点测评`;

const jsonLdGraph: any[] = [
  {
    '@type': 'BlogPosting',
    '@id': `${canonicalUrl}#article`,
    isPartOf: {
      '@type': 'WebSite',
      '@id': 'https://yebo.baby/#website',
      name: '夜泊',
      url: 'https://yebo.baby',
    },
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
    mainEntityOfPage: canonicalUrl,
    inLanguage: 'zh-CN',
    author: {
      '@type': 'Person',
      name: '夜泊',
      url: 'https://yebo.baby/about',
    },
    publisher: {
      '@type': 'Organization',
      name: '夜泊',
      url: 'https://yebo.baby',
    },
    keywords: keywordsContent,
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '首页',
        item: 'https://yebo.baby',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: post.data.category,
        item: 'https://yebo.baby/#posts',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.data.title,
        item: canonicalUrl,
      },
    ],
  },
];

if (post.data.faq && post.data.faq.length > 0) {
  jsonLdGraph.push({
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: post.data.faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': jsonLdGraph,
};
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} | 夜泊</title>
    <meta name="description" content={post.data.description} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph (Bing / Social / Copilot Rich Snippet) -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="夜泊" />
    <meta property="og:title" content={`${post.data.title} | 夜泊`} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    <meta property="article:modified_time" content={(post.data.updatedDate || post.data.pubDate).toISOString()} />
    <meta property="article:section" content={post.data.category} />
    {post.data.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${post.data.title} | 夜泊`} />
    <meta name="twitter:description" content={post.data.description} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!-- 顶部阅读进度条 -->
    <div id="read-progress" class="read-progress-bar"></div>

    <Header />

    <main class="post-detail-main">
      <div class="post-layout-container">
        <!-- 左侧/主体：文章核心内容 -->
        <article class="post-article">
          <!-- 面包屑与返回 -->
          <nav class="post-nav">
            <a href="/#posts" class="back-link">
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              <span>返回停泊锚地</span>
            </a>
            <span class="nav-sep">/</span>
            <span class="nav-cat">{post.data.category}</span>
          </nav>

          <!-- 文章头信息 -->
          <header class="article-header">
            <div class="article-meta">
              <span class="meta-tag">{post.data.category}</span>
              <span class="meta-dot">·</span>
              <time datetime={post.data.pubDate.toISOString()} class="meta-date">{formattedDate}</time>
              <span class="meta-dot">·</span>
              <span class="meta-readtime">预计阅读 {post.data.readTime}</span>
            </div>

            <h1 class="article-title">{post.data.title}</h1>
            <p class="article-desc">{post.data.description}</p>
          </header>

          <div class="article-divider"></div>

          <!-- 正文主体渲染 -->
          <div class="prose post-body">
            <Content />
          </div>

          <!-- 常见问题与排错答疑 (FAQ 结构化问答渲染，争夺 Bing 问答卡片) -->
          {post.data.faq && post.data.faq.length > 0 && (
            <section class="article-faq-section" id="faq">
              <div class="faq-section-header">
                <span class="faq-section-tag">[答疑解惑]</span>
                <h3 class="faq-section-title">常见问题与排障解答 (FAQ)</h3>
              </div>
              <div class="faq-accordion-list">
                {post.data.faq.map((item, idx) => (
                  <details class="faq-item" open={idx === 0}>
                    <summary class="faq-question">
                      <span class="faq-q-badge">Q{idx + 1}</span>
                      <span class="faq-q-text">{item.question}</span>
                      <svg class="faq-chevron" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </summary>
                    <div class="faq-answer">
                      <p>{item.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )}

          <!-- 底部标签 -->
          {post.data.tags && post.data.tags.length > 0 && (
            <footer class="article-footer">
              <div class="article-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag-pill">#{tag}</span>
                ))}
              </div>
            </footer>
          )}
        </article>

        <!-- 右侧：目录大纲导航 -->
        {tocHeadings.length > 0 && (
          <aside class="toc-sidebar">
            <div class="toc-sticky-box">
              <div class="toc-header">
                <span class="toc-title">目录导航</span>
              </div>
              <nav class="toc-nav">
                <ul class="toc-list">
                  {tocHeadings.map((h) => (
                    <li class={`toc-item depth-${h.depth}`}>
                      <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>

              <div class="toc-footer">
                <button class="back-to-top-btn" id="back-to-top" title="返回顶部">
                  <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none">
                    <polyline points="18 15 12 9 6 15"></polyline>
                  </svg>
                  <span>回到顶部</span>
                </button>
              </div>
            </div>
          </aside>
        )}
      </div>
    </main>

    <Footer />

    <!-- 阅读进度条与目录滚动联动交互脚本 -->
    <script>
      // 为正文内所有以 http 开头的外链以及 /go/ 跳转链自动添加 target="_blank"
      document.querySelectorAll('.post-body a[href^="http"], .post-body a[href^="/go/"]').forEach((a) => {
        a.setAttribute('target', '_blank');
        a.setAttribute('rel', 'noopener noreferrer');
      });

      // 自动为所有正文表格添加响应式横向滚动保护层
      document.querySelectorAll('.post-body table').forEach((table) => {
        if (!table.parentElement?.classList.contains('table-responsive-container')) {
          const wrapper = document.createElement('div');
          wrapper.className = 'table-responsive-container';
          table.parentNode?.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        }
      });

      // 顶部阅读进度条
      const progressBar = document.getElementById('read-progress');
      window.addEventListener('scroll', () => {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = totalHeight > 0 ? (window.scrollY / totalHeight) * 100 : 0;
        if (progressBar) {
          progressBar.style.width = `${progress}%`;
        }
      });

      // 右侧目录滚动联动高亮 (Scroll Spy)
      const tocLinks = document.querySelectorAll('.toc-link');
      const articleHeadings = Array.from(document.querySelectorAll('.post-body h2, .post-body h3'));

      if (articleHeadings.length > 0 && tocLinks.length > 0) {
        const updateActiveToc = () => {
          const scrollPos = window.scrollY + 120;
          let currentHeadingId = '';

          for (let i = 0; i < articleHeadings.length; i++) {
            const heading = articleHeadings[i] as HTMLElement;
            if (heading.offsetTop <= scrollPos) {
              currentHeadingId = heading.id;
            } else {
              break;
            }
          }

          tocLinks.forEach((link) => {
            if (currentHeadingId && link.getAttribute('data-slug') === currentHeadingId) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        };

        window.addEventListener('scroll', updateActiveToc, { passive: true });
        updateActiveToc();
      }

      // 回到顶部按钮
      const backToTopBtn = document.getElementById('back-to-top');
      if (backToTopBtn) {
        backToTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>

<style>
  .read-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, #38bdf8, #2dd4bf);
    z-index: 1000;
    width: 0%;
    transition: width 0.1s ease-out;
  }

  .post-detail-main {
    padding: 7rem 1.5rem 8rem;
    min-height: 100vh;
    background: #020610;
  }

  .post-layout-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 1024px) {
    .post-layout-container {
      grid-template-columns: minmax(0, 840px) 250px;
      justify-content: center;
      align-items: start;
    }
  }

  .post-article {
    width: 100%;
    min-width: 0;
  }

  /* 右侧目录导航 */
  .toc-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc-sidebar {
      display: block;
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 8rem);
    }
  }

  .toc-sticky-box {
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    padding-left: 1.25rem;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .toc-title {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .toc-nav {
    max-height: calc(100vh - 14rem);
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .toc-nav::-webkit-scrollbar {
    width: 3px;
  }
  .toc-nav::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
  }

  .toc-item.depth-3 {
    padding-left: 0.85rem;
  }

  .toc-link {
    display: block;
    font-size: 0.82rem;
    line-height: 1.5;
    color: #64748b;
    transition: all 0.2s ease;
    text-decoration: none;
    word-break: break-word;
  }

  .toc-link:hover {
    color: #cbd5e1;
  }

  .toc-link.active {
    color: #38bdf8;
    font-weight: 600;
  }

  .toc-footer {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .back-to-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 0.78rem;
    cursor: pointer;
    transition: color 0.2s ease;
    padding: 0;
  }

  .back-to-top-btn:hover {
    color: #38bdf8;
  }

  .post-nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: #64748b;
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: #38bdf8;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #7dd3fc;
  }

  .nav-sep {
    color: #334155;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #64748b;
    margin-bottom: 1rem;
  }

  .meta-tag {
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.04);
    padding: 0.15rem 0.55rem;
    border-radius: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-weight: 500;
  }

  .meta-dot {
    color: #334155;
  }

  .article-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.3;
    color: #f8fafc;
    margin-bottom: 1rem;
  }

  .article-desc {
    font-size: 1.15rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  .article-divider {
    height: 1px;
    background: linear-gradient(90deg, rgba(56, 189, 248, 0.2), transparent);
    margin-bottom: 2.5rem;
  }

  .post-body {
    margin-bottom: 2.5rem;
  }

  /* FAQ 常见问题手风琴组件样式 */
  .article-faq-section {
    margin: 3rem 0 2.5rem;
    padding: 1.5rem 1.6rem;
    background: rgba(10, 25, 47, 0.7);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 6px;
  }

  .faq-section-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .faq-section-tag {
    font-size: 0.78rem;
    color: #38bdf8;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-family: var(--font-sans);
  }

  .faq-section-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f8fafc;
    margin: 0;
    font-family: var(--font-sans);
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(15, 33, 62, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .faq-item[open] {
    border-color: rgba(56, 189, 248, 0.35);
    background: rgba(15, 33, 62, 0.85);
  }

  .faq-question {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-size: 0.95rem;
    font-weight: 600;
    color: #f1f5f9;
    transition: color 0.2s ease;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: #38bdf8;
  }

  .faq-q-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border-radius: 3px;
    border: 1px solid rgba(56, 189, 248, 0.3);
    flex-shrink: 0;
  }

  .faq-q-text {
    flex: 1;
    line-height: 1.45;
  }

  .faq-chevron {
    color: #64748b;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: #38bdf8;
  }

  .faq-answer {
    padding: 0.85rem 1rem 1rem 2.85rem;
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.65;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .faq-answer p {
    margin: 0;
  }

  .article-footer {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag-pill {
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    background: rgba(15, 33, 62, 0.85);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: #cbd5e1;
    font-size: 0.8rem;
    font-weight: 500;
    font-family: var(--font-sans);
    transition: all 0.2s ease;
  }

  .tag-pill:hover {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.5);
  }
</style>

