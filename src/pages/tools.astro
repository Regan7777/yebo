---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface ToolItem {
  id: string;
  name: string;
  category: 'proxy' | 'ai' | 'network' | 'media';
  badge: string;
  desc: string;
  icon: string;
  platforms: string[];
  officialUrl: string;
  officialBtnText: string;
  tutorialUrl: string;
  tutorialBtnText: string;
}

const tools: ToolItem[] = [
  {
    id: 'clash-verge-rev',
    name: 'Clash Verge Rev',
    category: 'proxy',
    badge: '代理客户端',
    desc: '基于 Tauri 框架打造的现代 Clash Meta/Mihomo 内核客户端，轻巧美观，支持智能分流与规则扩展配置。',
    icon: '/images/tools/clash-verge.png',
    platforms: ['Win', 'Mac', 'Linux'],
    officialUrl: 'https://github.com/clash-verge-rev/clash-verge-rev/releases',
    officialBtnText: '官网下载',
    tutorialUrl: '/posts/clash-verge-rev-tutorial',
    tutorialBtnText: '使用教程',
