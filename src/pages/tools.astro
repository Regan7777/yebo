    icon: '/images/tools/shadowrocket.png',
    platforms: ['iOS'],
    officialUrl: 'https://apps.apple.com/app/shadowrocket/id932747118',
    officialBtnText: 'App Store',
    tutorialUrl: '/posts/shadowrocket-tutorial',
    tutorialBtnText: '使用教程',
