    icon: '/images/tools/chatgpt.png',
    platforms: ['Web / App'],
    officialUrl: 'https://chatgpt.com',
    officialBtnText: '立即访问',
    tutorialUrl: 'https://help.openai.com',
    tutorialBtnText: '使用指南',
