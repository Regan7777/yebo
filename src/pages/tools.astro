  {
    id: 'claude',
    name: 'Claude',
    category: 'ai',
    badge: '代码与长文',
    desc: 'Anthropic 出品的新一代 AI 助手，以超长上下文理解能力、极低幻觉率与无与伦比的代码编写及技术文档处理见长。',
    icon: '/images/tools/claude.png',
    platforms: ['Web / App'],
    officialUrl: 'https://claude.ai',
    officialBtnText: '立即访问',
    tutorialUrl: 'https://docs.anthropic.com',
    tutorialBtnText: '使用指南',
  },
  {
    id: 'speedtest',
    name: 'Speedtest by Ookla',
