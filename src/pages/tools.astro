    icon: '/images/tools/karing.png',
    platforms: ['全平台'],
    officialUrl: 'https://karing.app',
    officialBtnText: '官网下载',
    tutorialUrl: '/posts/karing-tutorial',
    tutorialBtnText: '使用教程',
  },
  {
    id: 'deepseek',
    name: 'DeepSeek',
    category: 'ai',
    badge: '推理大模型',
